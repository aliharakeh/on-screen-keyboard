<Window x:Class="OnScreenKeyboard.VaultPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Icon="app.ico" Width="520" Height="400" MinWidth="440" MinHeight="280"
        Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource KeyStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Add item" Style="{StaticResource Action}" Click="Manage_Click"/>
                <TextBlock Text="Vault" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="TargetText" Foreground="#FFBBBBBB" TextTrimming="CharacterEllipsis" Margin="0,5"/>
            <TextBlock Text="Search saved items" Foreground="#FFBBBBBB" Margin="0,4"/>
            <TextBox x:Name="SearchBox" FontSize="14" Padding="5" Background="#FF2B2B2B" Foreground="White"
                     CaretBrush="White" BorderBrush="#FF555555" TextChanged="Search_Changed"
                     AutomationProperties.Name="Search saved items"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#FFFFC077" Margin="0,10,0,0"/>
        <ListBox x:Name="ItemList" Background="#FF1E1E1E" BorderThickness="0" Foreground="White" Margin="0,8,0,0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF2B2B2B" Padding="3" CornerRadius="4" Margin="0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="{Binding FavoriteLabel}" Style="{StaticResource Action}"
                                    FontSize="17" ToolTip="Pin or unpin favorite" AutomationProperties.Name="Toggle favorite" Click="Favorite_Click"/>
                            <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Action}" ToolTip="Delete saved item" Click="Delete_Click"/>
                            <Button DockPanel.Dock="Right" Content="Insert" Style="{StaticResource Action}" Background="#FF2D7DD2" Click="Insert_Click"/>
                            <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource Action}" Click="Edit_Click"/>
                            <StackPanel VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Display}" FontSize="11" Foreground="#FFBBBBBB" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
