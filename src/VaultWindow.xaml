<Window x:Class="OnScreenKeyboard.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New vault item" Icon="app.ico" Width="420" Height="410" MinWidth="360" MinHeight="350"
        Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource KeyStyle}" x:Key="Action">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="FormTitle" Text="New item" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Shortcut / name" Style="{StaticResource Label}"/>
            <TextBox x:Name="NameBox" AutomationProperties.Name="Shortcut or name"/>
            <TextBlock Text="Example: my-email or work-login. Type this to find your item." Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Text to insert" Style="{StaticResource Label}"/>
            <TextBox x:Name="ValueBox" AcceptsReturn="False" AutomationProperties.Name="Text to insert"/>
            <PasswordBox x:Name="SecretValueBox" Visibility="Collapsed" FontSize="14" Padding="4"
                         Background="#FF2B2B2B" Foreground="White" CaretBrush="White" BorderBrush="#FF555555"
                         AutomationProperties.Name="Secret text to insert"/>
            <CheckBox x:Name="RevealBox" Content="Show secret" Foreground="White" Margin="0,8,0,0"
                      Visibility="Collapsed" Click="SecretDisplay_Changed"/>
            <CheckBox x:Name="SecretBox" Content="This is a secret (e.g. a password)"
                      Foreground="White" Margin="0,10,0,0" Click="SecretDisplay_Changed"/>
            <TextBlock Text="Secrets are suggested by shortcut only. Saved data is encrypted for your Windows account."
                       Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,16,0,0">
                <Button Content="Save item" Style="{StaticResource Action}" Background="#FF2D7DD2" Click="Save_Click"/>
                <Button Content="Cancel" Style="{StaticResource Action}" Click="Cancel_Click"/>
            </WrapPanel>
            <TextBlock x:Name="Status" Foreground="#FF7FD18B" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
