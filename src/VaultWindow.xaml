<Window x:Class="OnScreenKeyboard.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Icon="app.ico" Width="620" Height="380" MinWidth="520" MinHeight="300"
        Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource KeyStyle}" x:Key="Action">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="+ New item" Style="{StaticResource Action}" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Click="New_Click"/>
            <ListBox x:Name="ItemList" Background="#FF2B2B2B" BorderBrush="#FF555555" Foreground="White"
                     HorizontalContentAlignment="Stretch" SelectionChanged="ItemList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Display}" Foreground="#FF999999" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="2">
            <TextBlock x:Name="FormTitle" Text="New item" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Name / keyword (type this to get the suggestion)" Style="{StaticResource Label}"/>
            <TextBox x:Name="NameBox"/>
            <TextBlock Text="Value (what gets typed)" Style="{StaticResource Label}"/>
            <TextBox x:Name="ValueBox" AcceptsReturn="False"/>
            <CheckBox x:Name="SecretBox" Content="Secret (password) – hide value, match by name only"
                      Foreground="White" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save" Style="{StaticResource Action}" Background="#FF2D7DD2" Click="Save_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource Action}" Click="Delete_Click"/>
            </StackPanel>
            <TextBlock x:Name="Status" Foreground="#FF7FD18B" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
