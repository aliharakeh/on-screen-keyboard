<Window x:Class="OnScreenKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="On-Screen Keyboard" Icon="app.ico"
        Width="960" Height="380" MinWidth="480" MinHeight="180"
        WindowStyle="None" AllowsTransparency="True" Background="#FF1E1E1E"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        FlowDirection="LeftToRight">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2B2B2B" Padding="8,5" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource KeyStyle}" FontSize="14"
                        Width="30" Height="24" Margin="6,0,0,0" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="—" Style="{StaticResource KeyStyle}" FontSize="14"
                        Width="30" Height="24" Margin="6,0,0,0" ToolTip="Minimize" Click="Minimize_Click"/>
                <Slider x:Name="OpacitySlider" DockPanel.Dock="Right" Width="90" Minimum="0.3" Maximum="1"
                        VerticalAlignment="Center" ToolTip="Opacity" ValueChanged="Opacity_ValueChanged"/>
                <ToggleButton x:Name="PinToggle" DockPanel.Dock="Right" Content="Pin" Style="{StaticResource BarToggle}"
                              ToolTip="Always on top" Click="Options_Click"/>
                <ToggleButton x:Name="NavToggle" DockPanel.Dock="Right" Content="Nav" Style="{StaticResource BarToggle}"
                              ToolTip="Navigation row" Click="Options_Click"/>
                <ToggleButton x:Name="FnToggle" DockPanel.Dock="Right" Content="Fn" Style="{StaticResource BarToggle}"
                              ToolTip="Function row" Click="Options_Click"/>
                <ToggleButton x:Name="NumToggle" DockPanel.Dock="Right" Content="123" Style="{StaticResource BarToggle}"
                              ToolTip="Number row" Click="Options_Click"/>
                <Button x:Name="LangButton" DockPanel.Dock="Left" Style="{StaticResource KeyStyle}" FontSize="14"
                        Width="44" Height="24" Margin="0,0,10,0" ToolTip="Switch input language (Win+Space)"
                        Click="Lang_Click"/>
                <TextBlock x:Name="WordText" Text="On-Screen Keyboard" Foreground="#FFAAAAAA" FontSize="16"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid x:Name="KeyRows" Grid.Row="1" Margin="6" SizeChanged="KeyRows_SizeChanged"/>
    </Grid>
</Window>
