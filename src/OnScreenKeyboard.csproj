<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>OnScreenKeyboard</RootNamespace>
    <AssemblyName>OnScreenKeyboard</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="Dictionaries\words.en.txt" LogicalName="words.en.txt" WithCulture="false" />
    <EmbeddedResource Include="Dictionaries\words.ar.txt" LogicalName="words.ar.txt" WithCulture="false" />
  </ItemGroup>

</Project>
