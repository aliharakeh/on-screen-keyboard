<Window x:Class="OnScreenKeyboard.WordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dictionary words" Icon="app.ico" Width="440" Height="520" MinWidth="360" MinHeight="300"
        Background="#FF1E1E1E" Foreground="White" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource KeyStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#FF3C3C3C" CornerRadius="4" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2D7DD2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Dictionary words" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Foreground="#FFBBBBBB" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Words used for predictions. Built-in lists are ordered from most to least common; your words are learned as you type."/>
            <WrapPanel>
                <RadioButton x:Name="MineTab" Style="{StaticResource Tab}" GroupName="List" Checked="Tab_Checked"/>
                <RadioButton x:Name="EnglishTab" Style="{StaticResource Tab}" GroupName="List" Checked="Tab_Checked"/>
                <RadioButton x:Name="ArabicTab" Style="{StaticResource Tab}" GroupName="List" Checked="Tab_Checked"/>
            </WrapPanel>
            <TextBox x:Name="SearchBox" FontSize="14" Padding="5" Margin="0,10,0,0" Background="#FF2B2B2B" Foreground="White"
                     CaretBrush="White" BorderBrush="#FF555555" TextChanged="Search_Changed"
                     AutomationProperties.Name="Search words"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#FFBBBBBB" Margin="0,8,0,0"/>
        <ListBox x:Name="WordList" Background="#FF1E1E1E" BorderThickness="0" Foreground="White" Margin="0,8,0,0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF2B2B2B" Padding="8,3" CornerRadius="4" Margin="0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource Action}"
                                    ToolTip="Forget this word" Click="Remove_Click"
                                    Visibility="{Binding Removable, Converter={StaticResource Visible}}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#FFAAAAAA" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Text="{Binding Word}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
